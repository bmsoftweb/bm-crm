# Porta do servidor (padrão 3000)
PORT=3000

# MySQL: HOST, USER e PASSWORD obrigatórios (o código não tem valor padrão); DATABASE padrão crmweb
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Chave que assina os tokens de sessão. Sem ela, uma chave aleatória é gerada a cada
# reinício do servidor e todos precisam entrar de novo.
SESSION_SECRET=

# Vercel: senha das rotinas agendadas (vercel.json › crons). A Vercel a envia como
# "Authorization: Bearer CRON_SECRET"; sem ela, /api/cron/* recusa tudo.
CRON_SECRET=

# BMDesk (acesso remoto pelo MeshCentral): botão "Baixar BMSoft Suporte" no widget e "Acessar computador"
# no atendimento. Mesma chave do INTEGRACAO_CHAVE do BMDesk. Vazio = integração desligada.
BMDESK_URL=https://desk.bmsoft.com.br
BMDESK_CHAVE=

# bm-help (assistente do chat do suporte enquanto o cliente espera na fila): usuário de serviço do bm-help,
# tipo cliente, ligado aos sistemas que o chat oferece e com a chave da Anthropic cadastrada. Vazio = sem assistente
BMHELP_URL=
BMHELP_EMAIL=
BMHELP_SENHA=
